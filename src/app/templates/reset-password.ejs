<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Password Changed - Blood Donation Platform</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      color: #333;
      padding: 30px 15px;
    }

    .container {
      max-width: 520px;
      margin: 0 auto;
      background: #fff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    }

    .header {
      background: #16a34a;
      color: white;
      text-align: center;
      padding: 35px 25px;
    }

    .icon {
      width: 65px;
      height: 65px;
      margin: 0 auto 15px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 35px;
    }

    .header h1 {
      font-size: 24px;
    }

    .content {
      padding: 35px 30px;
    }

    .content h2 {
      color: #16a34a;
      margin-bottom: 18px;
    }

    .content p {
      font-size: 15px;
      line-height: 1.7;
      margin-bottom: 15px;
    }

    .success-box {
      background: #f0fdf4;
      border-left: 4px solid #16a34a;
      padding: 16px;
      margin: 25px 0;
      color: #166534;
      border-radius: 5px;
    }

    .warning {
      background: #fff7ed;
      border-left: 4px solid #f97316;
      padding: 15px;
      color: #9a3412;
      font-size: 14px;
      line-height: 1.6;
      border-radius: 5px;
    }

    .footer {
      padding: 20px 30px;
      background: #f8fafc;
      text-align: center;
      color: #888;
      font-size: 12px;
    }
  </style>
</head>

<body>

  <div class="container">

    <div class="header">
      <div class="icon">✓</div>
      <h1>Password Updated Successfully</h1>
    </div>

    <div class="content">

      <h2>Hello <%= name %>,</h2>

      <p>
        Your Blood Donation Platform account password has been
        successfully changed.
      </p>

      <div class="success-box">
        <strong>✓ Password Reset Successful</strong><br />
        Your new password is now active.
      </div>

      <p>
        You can now log in to your account using your new password.
      </p>

      <div class="warning">
        <strong>Security Notice:</strong><br />
        If you did not make this change, please contact the
        Blood Donation Platform support team immediately.
      </div>

    </div>

    <div class="footer">
      © Blood Donation Platform. All rights reserved.
    </div>

  </div>

</body>
</html>