<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Password Reset - Blood Donation Platform</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      color: #333;
      padding: 30px 15px;
    }

    .container {
      max-width: 520px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    }

    .header {
      background: #dc2626;
      color: white;
      text-align: center;
      padding: 30px;
    }

    .header h1 {
      font-size: 25px;
      margin-bottom: 8px;
    }

    .header p {
      font-size: 14px;
    }

    .content {
      padding: 35px 30px;
    }

    .content h2 {
      color: #dc2626;
      margin-bottom: 18px;
    }

    .content p {
      font-size: 15px;
      line-height: 1.7;
      margin-bottom: 15px;
    }

    .otp-container {
      text-align: center;
      margin: 30px 0;
    }

    .otp {
      display: inline-block;
      background: #fef2f2;
      color: #dc2626;
      border: 2px dashed #dc2626;
      border-radius: 10px;
      padding: 18px 30px;
      font-size: 32px;
      font-weight: bold;
      letter-spacing: 10px;
    }

    .warning {
      background: #fff7ed;
      border-left: 4px solid #f97316;
      padding: 15px;
      margin-top: 25px;
      color: #9a3412;
      font-size: 14px;
      line-height: 1.6;
    }

    .footer {
      padding: 20px 30px;
      background: #f8fafc;
      text-align: center;
      color: #888;
      font-size: 12px;
    }
  </style>
</head>

<body>

  <div class="container">

    <div class="header">
      <h1>🩸 Blood Donation Platform</h1>
      <p>Account Security</p>
    </div>

    <div class="content">

      <h2>Password Reset Request</h2>

      <p>
        Hello <strong><%= name %></strong>,
      </p>

      <p>
        We received a request to reset the password for your
        Blood Donation Platform account.
      </p>

      <p>
        Use the verification code below to continue:
      </p>

      <div class="otp-container">
        <div class="otp"><%= otp %></div>
      </div>

      <p style="text-align: center; color: #666;">
        This OTP will expire in
        <strong><%= expirationMinutes %> minutes</strong>.
      </p>

      <div class="warning">
        <strong>Security Notice:</strong><br />
        If you did not request a password reset, please ignore
        this email and make sure your account credentials are secure.
      </div>

    </div>

    <div class="footer">
      © Blood Donation Platform. All rights reserved.
    </div>

  </div>

</body>
</html>