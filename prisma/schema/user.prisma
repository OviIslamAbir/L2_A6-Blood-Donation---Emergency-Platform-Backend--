model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  password       String?
  phone          String?   @unique
  role           Role      @default(DONOR)
  googleId       String?   @unique

  emailVerified  Boolean   @default(false)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  donorProfile   DonorProfile?

  bloodRequests  BloodRequest[] @relation("RequesterRequests")
  notifications  Notification[]
  payments       Payment[]
  auditLogs      AuditLog[]
 donorApplicationStatus DonorApplicationStatus @default(NONE)
  @@index([role])
  @@index([email])
  @@index([deletedAt])
  @@index([createdAt])
}