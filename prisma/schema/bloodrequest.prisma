model BloodRequest {
  id              String @id @default(uuid())

  requesterId     String
  requester       User @relation("RequesterRequests",fields: [requesterId], references: [id])

  patientName     String

  bloodGroup      BloodGroup
  units           Int

  hospitalName    String
  hospitalAddress String

  division        String?
  district        String?

  latitude        Decimal?
  longitude       Decimal?

  requesterType   RequesterType

  urgency         Urgency @default(NORMAL)

  status          RequestStatus @default(PENDING)

  neededAt        DateTime?
  reason          String?

  verifiedAt      DateTime?
  verifiedBy      String?

  completedAt     DateTime?
  deletedAt       DateTime?

  donorMatches    DonorMatch[]
  donations       Donation[]
  payments        Payment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([requesterId])
  @@index([bloodGroup])
  @@index([status])
  @@index([urgency])
  @@index([district])
  @@index([createdAt])
  @@index([deletedAt])
}