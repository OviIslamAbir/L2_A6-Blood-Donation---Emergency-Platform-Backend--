model AuditLog {
  id          String @id @default(uuid())

  userId      String?

  user        User? @relation(fields: [userId],references: [id])

  action      String
  entity      String
  entityId    String?

  oldValue    Json?
  newValue    Json?

  ipAddress   String?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}